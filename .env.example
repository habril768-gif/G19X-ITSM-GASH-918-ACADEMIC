# Plantilla: copiar a .env y completar solo en el equipo local.
API_PORT=8000
POSTGRES_DB=plurione
POSTGRES_USER=plurione
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
OPENAI_API_KEY=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# Activar solo con texto simulado revisado y worker configurado.
AI_ENABLED=false
OPENAI_MODEL=

# Captura de correo: perfil Compose mail; no entrega a buzones reales.
MAIL_ENABLED=false
MAIL_MODE=capture
SMTP_TLS=none
SMTP_FROM=no-reply@plurione.invalid
WEB_BASE_URL=http://127.0.0.1:5173
MAILPIT_PORT=8025

# Solo con compose.bi.yaml; conexión de Power BI con cuenta de lectura.
BI_POSTGRES_PORT=5433
