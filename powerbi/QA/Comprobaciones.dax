EVALUATE VAR a = FILTER(ALL(Indicadores), Indicadores[categoria_id] = "qa-cat-a") VAR b = FILTER(ALL(Indicadores), Indicadores[categoria_id] = "qa-cat-b") VAR suprimida = CALCULATE(SELECTEDVALUE(Indicadores[privacidad]), a) = "Suprimido por privacidad" VAR vacia = CALCULATE(ISBLANK([Volumen visible]) && ISBLANK([Resolución horas]) && ISBLANK([Reapertura porcentaje]) && ISBLANK([Concordancia porcentaje]), a) VAR conocida = CALCULATE([Volumen visible] = 20 && [Resolución horas] = 6 && ABS([Reapertura porcentaje] - 0.55) < 0.000001 && [Concordancia porcentaje] = 0.5, a) RETURN UNION(ROW("Control", "Dos_celdas", "Pasa", COUNTROWS(Indicadores) = 2), ROW("Control", "Celda_A_esperada", "Pasa", IF(suprimida, vacia, conocida)), ROW("Control", "Sin_denominadores", "Pasa", CALCULATE([Volumen visible] = 20 && ISBLANK([Resolución horas]) && ISBLANK([Reapertura porcentaje]) && ISBLANK([Concordancia porcentaje]), b)), ROW("Control", "Totales_BLANK", "Pasa", ISBLANK([Volumen visible]) && ISBLANK([Resolución horas]) && ISBLANK([Reapertura porcentaje]) && ISBLANK([Concordancia porcentaje])), ROW("Control", "Corte_coherente", "Pasa", [Fecha de corte] = DATE(2026, 1, 15) + TIME(12, IF(suprimida, 1, 0), 0)))