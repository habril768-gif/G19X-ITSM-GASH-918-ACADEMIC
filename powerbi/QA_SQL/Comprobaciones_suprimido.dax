EVALUATE VAR a = FILTER(ALL(Indicadores), Indicadores[categoria_id] = "2") VAR b = FILTER(ALL(Indicadores), Indicadores[categoria_id] = "4") RETURN UNION(ROW("Control", "Dos_celdas_SQL", "Pasa", COUNTROWS(Indicadores) = 2), ROW("Control", "Estado_SQL_esperado", "Pasa", CALCULATE(SELECTEDVALUE(Indicadores[privacidad]), a) = "Suprimido por privacidad"), ROW("Control", "Numeros_SQL_esperados", "Pasa", CALCULATE(ISBLANK([Volumen visible]) && ISBLANK([Resolución horas]) && ISBLANK([Reapertura porcentaje]) && ISBLANK([Concordancia porcentaje]), a)), ROW("Control", "Sin_denominadores", "Pasa", CALCULATE([Volumen visible] = 20 && ISBLANK([Resolución horas]) && ISBLANK([Reapertura porcentaje]) && ISBLANK([Concordancia porcentaje]), b)), ROW("Control", "Totales_BLANK", "Pasa", ISBLANK([Volumen visible]) && ISBLANK([Resolución horas]) && ISBLANK([Reapertura porcentaje]) && ISBLANK([Concordancia porcentaje])), ROW("Control", "Corte_SQL_esperado", "Pasa", FORMAT([Fecha de corte], "yyyy-MM-dd HH:mm:ss") = "2026-10-20 12:04:59"))
